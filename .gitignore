/target
# cargo-fuzz build output and campaign state live under fuzz/, which has its
# own .gitignore now -- the rules belong beside the crate they describe, and
# keeping them here made it easy to ignore fuzz/Cargo.lock along with them.
# That lockfile is committed: a detached workspace without one resolves
# differently on every machine, and the /fuzz Dependabot entry would have
# nothing to update.
**/*.rs.bk
Cargo.lock.bak
.DS_Store
.idea/
.vscode/
*.pdb

# Python build artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.so
*.pyd
*.egg-info/
dist/
.venv/
build/

# Node build artifacts (index.js / index.d.ts ARE committed)
node_modules/
*.node

# WASM build artifacts
bindings/wasm/pkg/

# Go: the C ABI library is staged per-platform by CI, never committed here.
bindings/go/lib/*/

# .NET build artifacts
bin/
obj/

# Java / Maven build artifacts
bindings/java/target/

# R build artifacts
bindings/r/.rlib/
bindings/r/src/*.o
bindings/r/src/*.so
bindings/r/src/*.dll
bindings/r/..Rcheck/

# Local secrets — never commit credentials.
.env
.env.*
*.key
secrets/

# R CMD check output, produced by the check job and by hand.
*.Rcheck/
wickrasynth_*.tar.gz

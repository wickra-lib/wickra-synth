{
  "name": "wickra-synth",
  "version": "0.1.1",
  "description": "Deterministic synthetic market-microstructure generator: a seeded GenSpec produces byte-identical OHLCV candles, order-book snapshots, trades and funding across every language binding. Node bindings powered by Rust.",
  "author": "kingchenc <support@wickra.org>",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "trading",
    "synthetic",
    "microstructure",
    "simulation",
    "finance",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wickra-lib/wickra-synth"
  },
  "bugs": {
    "url": "https://github.com/wickra-lib/wickra-synth/issues"
  },
  "homepage": "https://github.com/wickra-lib/wickra-synth",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "napi": {
    "name": "wickra-synth",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">= 22"
  },
  "optionalDependencies": {
    "wickra-synth-darwin-arm64": "0.1.1",
    "wickra-synth-darwin-x64": "0.1.1",
    "wickra-synth-linux-arm64-gnu": "0.1.1",
    "wickra-synth-linux-x64-gnu": "0.1.1",
    "wickra-synth-win32-arm64-msvc": "0.1.1",
    "wickra-synth-win32-x64-msvc": "0.1.1"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "version": "napi version",
    "test": "node --test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  }
}
